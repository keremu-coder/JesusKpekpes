+    foreach (var hz in new[] { 200.0, 1800.0, 3400.0, 7000.0 })
+    {
+        var biquads = chain.Select(f => new EqBiquad(f, sr)).ToArray();
+        double inE = 0, outE = 0;
+        for (var i = 0; i < sr; i++)
+        {
+            var x = (float)Math.Sin(2 * Math.PI * hz * i / sr) * 0.1f;
+            var y = x;
+            foreach (var b in biquads) y = b.Process(y);
+            if (i > sr / 2) { inE += x * x; outE += y * y; }
+        }
+        var measured = 10 * Math.Log10(outE / inE);
+        var predicted = ApoConfig.ResponseDb(chain, hz);
+        Check(Math.Abs(measured - predicted) < 0.3, $"{hz} Hz: rendered {measured:0.00} dB but predicted {predicted:0.00} dB");
+    }
+}
+
+// Config text: ASCII-safe numbers in any culture, always resets scope at the end.
+{
+    var oldCulture = System.Globalization.CultureInfo.CurrentCulture;
+    try
+    {
+        try { System.Globalization.CultureInfo.CurrentCulture = new System.Globalization.CultureInfo("de-DE"); }
+        catch (System.Globalization.CultureNotFoundException) { }
+        var text = ApoConfig.BuildStereo("Speakers (Test Headphones)", Preset.Footsteps, 0.7);
+        Check(!text.Contains("0,"), "numbers must use dots, not commas");
+        Check(text.Contains("Preamp: -"), "preamp line is missing");
+        Check(text.TrimEnd().EndsWith("Channel: all"), "config must end by resetting Channel");
+        Check(text.Contains("Device: all"), "config must reset Device");
+        Check(text.Contains("Device: Speakers (Test Headphones)"), "config must scope to the chosen device");
+        Check(text.All(c => c < 128), "config should be plain ASCII for ASCII device names");
+        var surround = ApoConfig.BuildSurround("Test", 100, 0);
+        Check(surround.Contains("Channel: SL SR RL RR"), "surround chain should address the surround channels");
+        Check(surround.TrimEnd().EndsWith("Channel: all"), "surround config must reset scope");
+        Check(!surround.Contains("0,"), "surround numbers must use dots");
+    }
+    finally { System.Globalization.CultureInfo.CurrentCulture = oldCulture; }
+}
+
+// The preview comes from the real chain: the "after" clip must not clip.
+{
+    var (dry, wet) = ApoConfig.RenderPreview(Preset.Footsteps, 1.0);
+    Check(wet.Select(x => Math.Abs(x)).Max() < 1.0f, "preview 'after' clip must not clip");
+    Check(dry.Select(x => Math.Abs(x)).Max() < 1.0f, "preview 'before' clip must not clip");
+    Check(dry.Select(x => Math.Abs(x)).Max() > 0.1f, "preview 'before' clip should not be silent");
+}
+
+// Config store: install, switch off, conflicts, remove, and the user's file is kept safe.
+{
+    var dir = Path.Combine(Path.GetTempPath(), "jk-test-" + Guid.NewGuid().ToString("N"));
+    Directory.CreateDirectory(dir);
+    try
+    {
+        var main = Path.Combine(dir, "config.txt");
+        File.WriteAllText(main, "# mine\r\nPreamp: -3 dB\r\nVSTPlugin: Library rara.dll\r\nInclude: HeSuVi\\hesuvi.txt\r\n");
+        var original = File.ReadAllText(main);
+        var store = new ConfigStore(dir);
+        Check(!store.IsOn(), "store should start off");
+        Check(store.Write(ApoConfig.BuildStereo("Test", Preset.Footsteps, 0.5)), "write should work");
+        Check(store.IsOn(), "store should be on after write");
+        Check(File.ReadAllText(main).StartsWith(original.TrimEnd()), "the user's own lines must stay untouched");
+        Check(File.ReadAllText(main).Contains(ConfigStore.IncludeLine), "include line should be added");
+        Check(File.Exists(Path.Combine(dir, "config.txt.jesuskpekpes-backup")), "a one-time backup should exist");
+        Check(File.ReadAllText(Path.Combine(dir, "config.txt.jesuskpekpes-backup")) == original, "backup must equal the original");
+        Check(store.Write(ApoConfig.BuildStereo("Test", Preset.Everyday, 0.5)), "second write should work");
+        var includes = File.ReadAllLines(main).Count(l => l.Trim() == ConfigStore.IncludeLine);
+        Check(includes == 1, $"include line must exist once, found {includes}");
+        var found = store.Conflicts();
+        Check(found.Any(c => c.Contains("HeSuVi")), "HeSuVi should be reported");
+        Check(found.Any(c => c.Contains("VST")), "a VST chain should be reported");
+        Check(store.Off(), "off should work");
+        Check(!store.IsOn(), "store should be off after Off()");
+        Check(File.ReadAllText(main).Contains(ConfigStore.IncludeLine), "Off must not edit config.txt");
+        Check(store.Remove(), "remove should work");
+        Check(!Directory.Exists(Path.Combine(dir, ConfigStore.Folder)), "our folder should be gone");
+        Check(File.ReadAllText(main) == original || File.ReadAllText(main).TrimEnd() == original.TrimEnd(), "remove must restore the user's lines");
+
+        // Old versions wrote jesus-kpekpes.txt and an include for it. We clean that up.
+        File.WriteAllText(main, "Preamp: -3 dB\r\nInclude: jesus-kpekpes.txt\r\n");
+        File.WriteAllText(Path.Combine(dir, "jesus-kpekpes.txt"), "Device: Old\r\n");
+        Check(store.Write(ApoConfig.BuildStereo("Test", Preset.Footsteps, 0.5)), "write after legacy should work");
+        Check(!File.ReadAllText(main).Contains("jesus-kpekpes.txt"), "legacy include should be removed");
+        Check(!File.Exists(Path.Combine(dir, "jesus-kpekpes.txt")), "legacy file should be removed");
+    }
+    finally { Directory.Delete(dir, true); }
+}
+
 Console.WriteLine("engine ok");
