<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JesusKpekpes</RootNamespace>
    <AssemblyName>JesusKpekpes</AssemblyName>
    <ApplicationIcon>jesus.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Compile Include="..\host\Engine.cs" Link="Engine.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\plugin\JesusKpekpesTune.dll" Condition="Exists('..\plugin\JesusKpekpesTune.dll')" Link="JesusKpekpesTune.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\pc\**\*" Exclude="..\pc\tests\**;..\pc\**\__pycache__\**;..\pc\**\*.pyc">
      <Link>pc\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
